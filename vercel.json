{
  "redirects": [
    { "source": "/afiliados", "destination": "https://linkup-community.web.app/", "permanent": false },
    { "source": "/afiliados/:path*", "destination": "https://linkup-community.web.app/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/cuponera", "destination": "https://link-up-mlm-2025-merchants.web.app/cuponera/" },
    { "source": "/cuponera/:path*", "destination": "https://link-up-mlm-2025-merchants.web.app/cuponera/:path*" },
    { "source": "/leads-afiliado", "destination": "https://linkup-encuesta-2026.web.app/index.html" },
    { "source": "/leads-comercios", "destination": "https://linkup-encuesta-2026.web.app/comercios.html" },
    { "source": "/leads", "destination": "https://linkup-encuesta-2026.web.app/admin/login" },
    { "source": "/leads/:path*", "destination": "https://linkup-encuesta-2026.web.app/admin/:path*" },
    { "source": "/admin/:path*", "destination": "https://linkup-encuesta-2026.web.app/admin/:path*" }
  ]
}
